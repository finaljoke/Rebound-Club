// The online rooms' Worker (server/worker.mjs, Issue #5), on its own subdomain of the site's domain, apart from the static
// site (which needs no change). `npx wrangler deploy` here creates the subdomain's DNS record and certificate; locally,
// `npx wrangler dev` runs it on port 8787.
{
  "name": "rebound-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      {"name": "ROOMS", "class_name": "Room"},
      {"name": "HUB", "class_name": "RoomHub"}
    ]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Room", "RoomHub"]}],
  "routes": [{"pattern": "rebound-api.snowiscoming.com", "custom_domain": true}],
  // Pages allowed to connect, comma-separated: the site, and its preview of online play. Local play needs none of
  // this: pages the dev server serves use its own stand-in (scripts/dev-rooms.mjs), not this Worker. To try such a page
  // against `wrangler dev` (?api=ws://127.0.0.1:8787/api/ws), add http://localhost:4173 here for the while: `wrangler dev`
  // keeps this value even over --var and .dev.vars.
  "vars": {"ALLOWED_ORIGINS": "https://reboundclub.snowiscoming.com,https://reboundclub-preview.snowiscoming.com"}
}
